+export const formatCurrency = (amount: number) => {
+    return new Intl.NumberFormat('en-US', {
+        style: 'currency',
+        currency: 'USD',
+    }).format(amount);
+};
+
+export const formatDate = (dateString: string) => {
+    return new Date(dateString).toLocaleDateString('en-US', {
